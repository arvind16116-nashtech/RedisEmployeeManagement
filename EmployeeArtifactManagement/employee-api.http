@baseUrl = http://localhost:8080
@employeeId = 1

### Create
POST {{baseUrl}}/api/employees
Content-Type: application/json

{
  "id": null,
  "fullName": "Ada Lovelace",
  "email": "ada.lovelace@example.com",
  "department": "Engineering",
  "salary": 125000.00
}

### List (cached as employees)
GET {{baseUrl}}/api/employees

### Read by ID (cached as employee)
GET {{baseUrl}}/api/employees/{{employeeId}}

### Update (refreshes employee cache and evicts list cache)
PUT {{baseUrl}}/api/employees/{{employeeId}}
Content-Type: application/json

{
  "id": {{employeeId}},
  "fullName": "Ada Lovelace",
  "email": "ada.lovelace@example.com",
  "department": "Research",
  "salary": 130000.00
}

### Delete (evicts employee and list caches)
DELETE {{baseUrl}}/api/employees/{{employeeId}}

### Missing employee should return 404
GET {{baseUrl}}/api/employees/999999